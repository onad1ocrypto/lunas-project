# ─────────────────────────────────────────────────────────────
# Lunas — environment
# Copy to .env.local, or set these in Vercel → Project → Settings
# → Environment Variables. No credentials needed to run the UI:
# PayPal routes answer { enabled: false } and the agents fall
# back to a deterministic local engine.
# ─────────────────────────────────────────────────────────────

# ── PayPal (developer.paypal.com → Apps & Credentials) ───────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Enables signature verification on POST /api/paypal/webhook.
# Subscribe that webhook to: PAYMENT.CAPTURE.COMPLETED,
# PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.REFUNDED,
# PAYMENT.PAYOUTSBATCH.SUCCESS, PAYMENT.PAYOUTSBATCH.DENIED
PAYPAL_WEBHOOK_ID=
# Set to 1 to use api-m.paypal.com instead of the sandbox host.
PAYPAL_LIVE=
# Client id for any browser-side PayPal usage.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ── Agents (Contract / Verification / Mediator) ──────────────
# Any OpenAI-compatible endpoint works.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ── Build stamp ──────────────────────────────────────────────
# Injected by the deploy script; shown in the landing-page footer.
BUILD_SHA=
