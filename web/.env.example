# ─────────────────────────────────────────────────────────────
# Lunas — environment
# Copy to .env.local, or set these in Vercel → Project → Settings
# → Environment Variables. No credentials needed to run the UI:
# PayPal routes answer { enabled: false } and the agents fall
# back to a deterministic local engine.
# ─────────────────────────────────────────────────────────────

# ── PayPal (developer.paypal.com → Apps & Credentials) ───────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Enables signature verification on POST /api/paypal/webhook.
# Subscribe that webhook to: PAYMENT.CAPTURE.COMPLETED,
# PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.REFUNDED,
# PAYMENT.PAYOUTSBATCH.SUCCESS, PAYMENT.PAYOUTSBATCH.DENIED
PAYPAL_WEBHOOK_ID=
# Set to 1 to use api-m.paypal.com instead of the sandbox host.
PAYPAL_LIVE=
# Client id for any browser-side PayPal usage.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ── Agents (Contract / Verification / Mediator) ──────────────
# Any OpenAI-compatible endpoint works.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ── Sessions ("Log in with PayPal" + guest mode) ─────────────
# HMAC key that signs the session cookie. Falls back to
# PAYPAL_CLIENT_SECRET, but set your own so the keys stay separate.
AUTH_SECRET=
# Optional: public origin used to build the OAuth return URL.
# Must match the Return URL registered in the dashboard, e.g.
# https://lunas-project.vercel.app/api/auth/paypal/callback
APP_ORIGIN=

# ── Public profile storage (Supabase) ────────────────────────
# Makes /to/<handle> show the *published* profile, so clients on
# other devices see the real photo, links and portfolio.
# Project URL + a SECRET key (Project Settings → API).
# The secret key bypasses row level security: server-side only,
# never expose it to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── AG Studio (Insights dashboard) ───────────────────────────
# Optional: without a key the dashboard still works, with a watermark.
# Trial keys are front-end licences, so this one is public by design
# (evaluation only — do not ship to production unlicensed).
NEXT_PUBLIC_AG_STUDIO_LICENSE=

# ── Build stamp ──────────────────────────────────────────────
# Injected by the deploy script; shown in the landing-page footer.
BUILD_SHA=
