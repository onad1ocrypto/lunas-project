# ─────────────────────────────────────────────────────────────────────────────
# Lunas — environment
#
# Copy to .env.local (or set these in Vercel → Project → Settings → Environment
# Variables). Everything is optional: with no keys at all Lunas boots in
# *simulation mode* and the whole escrow flow still runs, clearly labelled.
# ─────────────────────────────────────────────────────────────────────────────

# ── PayPal (developer.paypal.com → Apps & Credentials → Sandbox) ─────────────
# Sandbox app: use the "sandbox" credentials. Live app: also set PAYPAL_ENV=live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" (default) or "live"
PAYPAL_ENV=sandbox
# Webhook id from the sandbox app's Webhooks section — required for signature
# verification. Subscribe to:
#   PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.REFUNDED,
#   PAYMENT.PAYOUTSBATCH.SUCCESS, PAYMENT.PAYOUTSBATCH.DENIED
PAYPAL_WEBHOOK_ID=
# Only needed if you use a different client id for the browser SDK.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Sandbox account that receives the released escrow (Payouts recipient —
# a *business* sandbox account; Payouts cannot pay a personal account).
PAYPAL_PAYOUT_RECEIVER=sari.wulandari-facilitator@example.com

# ── AI agents ────────────────────────────────────────────────────────────────
# Contract Agent + Verification Agent. Works with any OpenAI-compatible gateway
# (OpenAI, OpenRouter, Groq, Ollama, vLLM…) or Anthropic.
LLM_API_KEY=
LLM_PROVIDER=openai            # openai | anthropic
LLM_BASE_URL=                  # blank = provider default
LLM_MODEL=gpt-4o-mini
LLM_VISION_MODEL=              # model used for image criteria (blank = LLM_MODEL)

# ── Lunas itself ─────────────────────────────────────────────────────────────
# Escrow & protection fee added on top of the contract amount (0.025 = 2.5%).
LUNAS_FEE_RATE=0.025
# Where the order ledger + uploads are stored. Defaults to ./.data
LUNAS_DATA_DIR=
